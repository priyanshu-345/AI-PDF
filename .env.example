# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_pdf_toolkit?schema=public"

# Redis (BullMQ Queues & Cache)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & Security
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-minimum-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-minimum-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# AWS S3 / Cloud Storage (or MinIO for local dev)
AWS_REGION="us-east-1"
S3_BUCKET_NAME="ai-pdf-toolkit-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_ENDPOINT="http://localhost:9000" # Leave empty for production AWS S3
S3_FORCE_PATH_STYLE=true           # Set true for MinIO, false for AWS

# OpenAI API (LLM & Embeddings)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL_CHAT="gpt-4o-mini"
OPENAI_MODEL_EMBEDDING="text-embedding-3-small"

# Server Ports
API_PORT=4000
API_BASE_URL="http://localhost:4000/api/v1"

# Mobile App
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api/v1" # 10.0.2.2 is localhost for Android Emulator
