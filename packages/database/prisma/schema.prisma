datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum JobType {
  INDEX_RAG
  OCR
  MERGE
  SPLIT
  COMPRESS
  ROTATE
  WATERMARK
  PAGE_NUMBERS
  CONVERT_WORD
  CONVERT_EXCEL
  CONVERT_IMAGES
  TRANSLATE
  SUMMARIZE
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  fullName          String?
  avatarUrl         String?
  role              Role              @default(USER)
  tier              SubscriptionTier  @default(FREE)
  storageUsedBytes  BigInt            @default(0)
  storageQuotaBytes BigInt            @default(104857600) // 100 MB default
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  documents         Document[]
  conversations     Conversation[]
  processingJobs    ProcessingJobs[]
  usageLogs         UsageLogs[]
  auditLogs         AuditLogs[]

  @@map("users")
}

model Document {
  id             String         @id @default(uuid())
  userId         String
  fileName       String
  originalName   String
  mimeType       String         @default("application/pdf")
  fileSizeBytes  Int
  storageKey     String         // S3 Object Key
  pageCount      Int            @default(0)
  isScanned      Boolean        @default(false)
  isIndexed      Boolean        @default(false)
  summary        String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages          DocumentPage[]
  chunks         DocumentChunk[]
  conversations  Conversation[]
  jobs           ProcessingJobs[]
  generatedFiles GeneratedFile[]

  @@index([userId])
  @@map("documents")
}

model DocumentPage {
  id              String         @id @default(uuid())
  documentId      String
  pageNumber      Int
  extractedText   String?        @db.Text
  ocrProcessed    Boolean        @default(false)
  previewImageUrl String?

  document        Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

model DocumentChunk {
  id             String                        @id @default(uuid())
  documentId     String
  pageNumber     Int
  chunkIndex     Int
  content        String                        @db.Text
  embedding      Unsupported("vector(1536)")?  // OpenAI text-embedding-3-small
  createdAt      DateTime                      @default(now())

  document       Document                      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model Conversation {
  id             String         @id @default(uuid())
  userId         String
  documentId     String
  title          String         @default("New Chat")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([userId])
  @@index([documentId])
  @@map("conversations")
}

model Message {
  id             String         @id @default(uuid())
  conversationId String
  sender         String         // "user" | "assistant"
  text           String         @db.Text
  citations      Json?          // Array of { pageNumber: number, snippet: string, score: number }
  tokensUsed     Int            @default(0)
  createdAt      DateTime       @default(now())

  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ProcessingJobs {
  id             String         @id @default(uuid())
  userId         String
  documentId     String?
  jobType        JobType
  status         JobStatus      @default(PENDING)
  progress       Int            @default(0)   // 0 to 100%
  errorMessage   String?
  resultPayload  Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  document       Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("processing_jobs")
}

model GeneratedFile {
  id             String         @id @default(uuid())
  documentId     String?
  outputName     String
  fileSizeBytes  Int
  storageKey     String         // S3 key to output file
  mimeType       String
  expiresAt      DateTime?      // Temporary retention
  createdAt      DateTime       @default(now())

  document       Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@map("generated_files")
}

model UsageLogs {
  id             String         @id @default(uuid())
  userId         String
  action         String
  unitsConsumed  Int            @default(1)
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("usage_logs")
}

model AuditLogs {
  id             String         @id @default(uuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  action         String
  createdAt      DateTime       @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
